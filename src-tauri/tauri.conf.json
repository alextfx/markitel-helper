{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markitel Helper",
  "version": "0.0.1",
  "identifier": "com.markitel.helper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 https://markitel.com"
    },
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Markitel Helper",
        "label": "main",
        "width": 420,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray-idle.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Markitel Helper"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "© Markitel",
    "targets": ["dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "windows": {
      "allowDowngrades": true,
      "wix": {
        "fragmentPaths": [],
        "template": null
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["markitel"]
      }
    }
  }
}
